{
  "expo": {
    "name": "DailySky",
    "slug": "dailysky",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "description": "DailySky - Minimal, real-time meteorological and air quality companion with native Android home-screen widgets and severe weather alerts.",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.weathercompanion.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "DailySky requests your location to provide accurate local temperature, humidity, and atmospheric air quality readings."
      }
    },
    "android": {
      "package": "com.weathercompanion.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#F7F7F2",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "WAKE_LOCK"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "ee515650-3b5e-4376-ad4a-aa1a9339ee8c"
      }
    }
  }
}
