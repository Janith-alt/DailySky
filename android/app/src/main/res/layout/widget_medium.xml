<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_med_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_light"
    android:orientation="horizontal"
    android:padding="16dp">

    <!-- Left section: Location & Temperature -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_med_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Location"
            android:textColor="#858982"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true" />

        <TextView
            android:id="@+id/widget_med_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="21°"
            android:textColor="#202321"
            android:textSize="38sp"
            android:fontFamily="sans-serif-light" />

        <TextView
            android:id="@+id/widget_med_highlow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="H: 24°  L: 15°"
            android:textColor="#858982"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="12dp"
        android:background="#E3E3DC" />

    <!-- Right section: Condition, AQI & Timestamp -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_med_condition"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mainly Clear"
            android:textColor="#202321"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#E8EFE9"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp">

            <TextView
                android:id="@+id/widget_med_aqi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AQI 32 · Good"
                android:textColor="#5E7D61"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/widget_med_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Updated just now"
            android:textColor="#858982"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
